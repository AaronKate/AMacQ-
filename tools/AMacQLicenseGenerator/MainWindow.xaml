<Window x:Class="AMacQLicenseGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMacQ 授权签发工具" Width="640" Height="430" MinWidth="640" MinHeight="430"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <Color x:Key="AppStart">#101B36</Color><Color x:Key="AppEnd">#050914</Color><Color x:Key="TitleStart">#172A56</Color><Color x:Key="TitleEnd">#0B1430</Color>
    <Color x:Key="AccentA">#5EB5FF</Color><Color x:Key="AccentB">#5672FF</Color><Color x:Key="PanelStart">#172B54</Color><Color x:Key="PanelEnd">#080E20</Color><Color x:Key="InputStart">#142542</Color><Color x:Key="InputEnd">#081124</Color>
    <Color x:Key="PrimaryText">#F7F2FF</Color><Color x:Key="SecondaryText">#B9CAE0</Color><Color x:Key="Border">#5278AF</Color><Color x:Key="Focus">#92D2FF</Color><Color x:Key="Hover">#213E6B</Color><Color x:Key="Pressed">#142D52</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource PrimaryText}"/><SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource SecondaryText}"/><SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource Border}"/><SolidColorBrush x:Key="FocusBrush" Color="{DynamicResource Focus}"/><SolidColorBrush x:Key="HoverBrush" Color="{DynamicResource Hover}"/><SolidColorBrush x:Key="PressedBrush" Color="{DynamicResource Pressed}"/>
    <LinearGradientBrush x:Key="AppBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource AppStart}" Offset="0"/><GradientStop Color="{DynamicResource AppEnd}" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource TitleStart}" Offset="0"/><GradientStop Color="{DynamicResource TitleEnd}" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource PanelStart}" Offset="0"/><GradientStop Color="{DynamicResource PanelEnd}" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="InputBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource InputStart}" Offset="0"/><GradientStop Color="{DynamicResource InputEnd}" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource AccentA}" Offset="0"/><GradientStop Color="{DynamicResource AccentB}" Offset="1"/></LinearGradientBrush>
    <Style x:Key="InputStyle" TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource FocusBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="ActionButton" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="16,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource PressedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="CloseButtonStyle" TargetType="Button"><Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="b" Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource TitleBrush}"/><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="{DynamicResource TitleBrush}"/><Setter TargetName="b" Property="Opacity" Value="0.48"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Border x:Name="WindowShell" Background="{DynamicResource AppBrush}" CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid IsHitTestVisible="False" Opacity="0.075"><Rectangle><Rectangle.Fill><DrawingBrush Viewport="0,0,26,26" ViewportUnits="Absolute" TileMode="Tile"><DrawingBrush.Drawing><GeometryDrawing Geometry="M 0,0 L 26,0 M 0,0 L 0,26"><GeometryDrawing.Pen><Pen Brush="{DynamicResource FocusBrush}" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Rectangle.Fill></Rectangle></Grid>
      <Ellipse Width="450" Height="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-190,-190,0,0" Opacity=".2" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentA}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
      <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource TitleBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><Grid><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0"><TextBlock Text="AMacQ" FontWeight="SemiBold"/><TextBlock Text=" · 授权签发工具" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel><Button Name="CloseButton" Content="×" Width="44" Height="42" HorizontalAlignment="Right" FontSize="22" Style="{StaticResource CloseButtonStyle}" Click="CloseButton_Click"/></Grid></Border>
        <Grid Grid.Row="1" Margin="24,16"><Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20,16"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel><TextBlock Text="设备许可证签发" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/><TextBlock Text="私钥仅限作者本机使用；生成的 JSON 文件才可交付给对应用户。" Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}"/></StackPanel>
          <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions><TextBlock Text="私钥文件" VerticalAlignment="Center" FontWeight="SemiBold"/><Border Grid.Column="1" Height="34" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="7" ToolTip="{Binding Tag, ElementName=PrivateKeyDisplay}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0"><TextBlock Text="◈" Foreground="{DynamicResource FocusBrush}" Margin="0,0,8,0"/><TextBlock x:Name="PrivateKeyDisplay" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></StackPanel></Border><Button Grid.Column="2" Content="选择…" Margin="10,0,0,0" Style="{StaticResource ActionButton}" Click="ChoosePrivateKey_Click"/></Grid>
          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="用户机器码" VerticalAlignment="Top" Margin="0,7,0,0" FontWeight="SemiBold"/><TextBox x:Name="MachineCodeBox" Grid.Column="1" Height="58" Padding="10,7" Style="{StaticResource InputStyle}" AcceptsReturn="True" TextWrapping="Wrap" FontFamily="Consolas"/></Grid>
          <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock Text="授权类型" VerticalAlignment="Center" FontWeight="SemiBold"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="PerpetualButton" Content="永久授权" Width="104" Style="{StaticResource ActionButton}" Background="{DynamicResource AccentBrush}" BorderThickness="0" Click="PerpetualButton_Click"/><Button x:Name="ExpiryButton" Content="到期授权" Width="104" Margin="10,0,0,0" Style="{StaticResource ActionButton}" Click="ExpiryButton_Click"/></StackPanel></Grid>
          <Grid Grid.Row="7" Margin="0,8,0,0" Visibility="Collapsed" x:Name="ExpiryDateArea"><Grid.ColumnDefinitions><ColumnDefinition Width="94"/><ColumnDefinition Width="170"/><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock x:Name="ExpiryLabel" Grid.Column="0" Text="到期日期" VerticalAlignment="Center" FontWeight="SemiBold"/><TextBox x:Name="ExpiryDateBox" Grid.Column="1" Height="36" Padding="10,0" VerticalContentAlignment="Center" Style="{StaticResource InputStyle}" ToolTip="请输入 yyyy-MM-dd" PreviewMouseLeftButtonDown="ExpiryDateBox_PreviewMouseLeftButtonDown"/><Button Grid.Column="2" Content="▣" Height="36" Margin="4,0,0,0" Style="{StaticResource ActionButton}" Foreground="{DynamicResource FocusBrush}" FontFamily="Segoe UI Symbol" FontSize="15" Padding="0" Click="ShowCalendar_Click"/><Popup x:Name="CalendarPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=ExpiryDateArea}" StaysOpen="False" AllowsTransparency="True"><Border Margin="0,6,0,0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="1" CornerRadius="8" Padding="8"><Calendar x:Name="ExpiryCalendar" SelectedDatesChanged="ExpiryCalendar_SelectedDatesChanged"/></Border></Popup></Grid>
          <Grid Grid.Row="9"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Foreground="{DynamicResource SecondaryTextBrush}" Text="永久授权不会自动失效" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,20,0"/><Button Grid.Column="1" Content="生成许可证…" Style="{StaticResource ActionButton}" Background="{DynamicResource AccentBrush}" BorderThickness="0" FontWeight="SemiBold" Padding="22,10" Click="Generate_Click"/></Grid>
        </Grid></Border></Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
