<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\AMacQ.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AuthorEdition)' == 'true'">
    <DefineConstants>$(DefineConstants);AUTHOR_EDITION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <!-- 常驻回归测试需要访问 internal 的筛选规则、监听器与窗口契约。 -->
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AMacQConfigEditor.Tests</_Parameter1>
    </AssemblyAttribute>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="..\..\assets\AMacQ.ico" LogicalName="AMacQConfigEditor.Resources.AMacQ.ico" />
    <EmbeddedResource Include="Resources\Sorin 25.1 S11-N3-1.zip" LogicalName="AMacQConfigEditor.Resources.SorinPackage.zip" />
    <Resource Include="Resources\Guide\01-open-profile-menu.png" />
    <Resource Include="Resources\Guide\02-select-desktop-profile.png" />
    <Resource Include="Resources\Guide\03-create-lua-script.png" />
    <Resource Include="Resources\Guide\04-import-lua-file.png" />
    <Resource Include="Resources\Guide\05-save-and-run.png" />
  </ItemGroup>
</Project>
