<Window x:Class="AMacQConfigEditor.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AMacQ 授权" Width="500" Height="330" MinWidth="500" MinHeight="330"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <Color x:Key="SurfaceAppStartColor">#172D4A</Color><Color x:Key="SurfaceAppEndColor">#091421</Color>
    <Color x:Key="SurfaceTitleStartColor">#1F4268</Color><Color x:Key="SurfaceTitleEndColor">#10233B</Color>
    <Color x:Key="AccentCyanColor">#22D3EE</Color><Color x:Key="AccentIndigoColor">#6366F1</Color>
    <Color x:Key="SurfacePanelStartColor">#1A3556</Color><Color x:Key="SurfacePanelEndColor">#0F2038</Color>
    <Color x:Key="SurfaceInputStartColor">#132440</Color><Color x:Key="SurfaceInputEndColor">#0D1B32</Color>
    <Color x:Key="TextPrimaryColor">#F7F2FF</Color><Color x:Key="TextSecondaryColor">#B9CAE0</Color><Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="BorderControlColor">#4E8FAE</Color><Color x:Key="BorderFocusColor">#5DD7FF</Color><Color x:Key="BorderDividerColor">#31506E</Color><Color x:Key="BorderPanelColor">#6488C4</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextPrimaryColor}"/><SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}"/><SolidColorBrush x:Key="PanelBorder" Color="{DynamicResource BorderPanelColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{DynamicResource BorderFocusColor}"/><SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource BorderDividerColor}"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{DynamicResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="TitleBarPressedBrush" Color="{DynamicResource ControlPressedColor}"/>
    <LinearGradientBrush x:Key="TerminalBackground" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource SurfaceAppStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceAppEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeonAccent" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="{DynamicResource AccentCyanColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource AccentIndigoColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleBarSurfaceBrush" StartPoint="0,0" EndPoint="1,0"><GradientStop Color="{DynamicResource SurfaceTitleStartColor}" Offset="0"/><GradientStop Color="{DynamicResource SurfaceTitleEndColor}" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="PanelSurfaceBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource SurfacePanelStartColor}" Offset="0"/><GradientStop Color="{DynamicResource SurfacePanelEndColor}" Offset="1"/></LinearGradientBrush>
    <LinearGradientBrush x:Key="InputSurfaceBrush" StartPoint="0,0" EndPoint="1,1"><GradientStop Color="{DynamicResource SurfaceInputStartColor}" Offset="0"/><GradientStop Color="{DynamicResource SurfaceInputEndColor}" Offset="1"/></LinearGradientBrush>
    <SolidColorBrush x:Key="MutedText" Color="{DynamicResource TextSecondaryColor}"/>
    <Style x:Key="TerminalButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
      <Setter Property="Background" Value="{DynamicResource NeonAccent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="AccentButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AccentButtonSurface" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="AccentButtonSurface" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="AccentButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseTitleBarButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="CloseButtonSurface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CloseButtonSurface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="CloseButtonSurface" Property="Background" Value="{DynamicResource TitleBarPressedBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowShell" Background="{DynamicResource TerminalBackground}" CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid Name="TerminalGridLayer" IsHitTestVisible="False" Opacity="0.06">
        <Rectangle>
          <Rectangle.Fill>
            <DrawingBrush Viewport="0,0,28,28" ViewportUnits="Absolute" TileMode="Tile" Stretch="None">
              <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 0,0 L 28,0 M 0,0 L 0,28"><GeometryDrawing.Pen><Pen Brush="{DynamicResource FocusBorderBrush}" Thickness="1"/></GeometryDrawing.Pen></GeometryDrawing>
              </DrawingBrush.Drawing>
            </DrawingBrush>
          </Rectangle.Fill>
        </Rectangle>
      </Grid>
      <Ellipse Width="400" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-180,-160,0,0" Opacity="0.22" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentCyanColor}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Ellipse Width="380" Height="300" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-160,-140" Opacity="0.18" IsHitTestVisible="False">
        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="{DynamicResource AccentIndigoColor}" Offset="0"/><GradientStop Color="#00000000" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
      </Ellipse>
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource TitleBarSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
          <Grid>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
              <Image Name="TitleBarIcon" Width="20" Height="20" Margin="0,0,8,0"/>
              <TextBlock Text="AMacQ · 设备授权" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
            </StackPanel>
            <Button Name="CloseButton" Content="×" Width="42" Height="40" HorizontalAlignment="Right" FontSize="22" Foreground="{DynamicResource PrimaryTextBrush}"
                    Style="{StaticResource CloseTitleBarButton}" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,20">
          <Border Background="{DynamicResource PanelSurfaceBrush}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" Padding="20">
            <Grid>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock Text="设备授权" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource NeonAccent}"/>
              <TextBlock Grid.Row="1" Margin="0,6,0,18" Text="复制机器码并发送给授权方，再导入许可证文件。" Foreground="{StaticResource MutedText}" FontSize="12"/>
              <TextBlock Grid.Row="2" Text="机器码" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="11" FontWeight="SemiBold"/>
              <Grid Grid.Row="3" Margin="0,8,0,18">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="7" Padding="12,8" Margin="0,0,10,0">
                  <TextBox Name="MachineCodeBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" VerticalContentAlignment="Center"/>
                </Border>
                <Button Name="CopyMachineCodeButton" Grid.Column="1" Content="复制机器码" Style="{StaticResource TerminalButton}" VerticalAlignment="Center"/>
              </Grid>
              <Grid Grid.Row="4">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Name="StatusText" Foreground="{StaticResource MutedText}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,14,0"/>
                <Button Name="ImportButton" Grid.Column="1" Content="导入许可证" Style="{StaticResource AccentButton}"/>
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Border>
</Window>
