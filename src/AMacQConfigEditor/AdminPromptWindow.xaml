<Window x:Class="AMacQConfigEditor.AdminPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="需要管理员权限" Width="400" Height="190"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None"
        AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" ShowInTaskbar="True">
  <Window.Resources>
    <Color x:Key="SurfaceAppStartColor">#172D4A</Color>
    <Color x:Key="SurfaceAppEndColor">#091421</Color>
    <Color x:Key="SurfaceTitleStartColor">#1F4268</Color>
    <Color x:Key="SurfaceTitleEndColor">#10233B</Color>
    <Color x:Key="AccentCyanColor">#22D3EE</Color>
    <Color x:Key="AccentIndigoColor">#6366F1</Color>
    <Color x:Key="SurfaceInputStartColor">#132440</Color>
    <Color x:Key="SurfaceInputEndColor">#0D1B32</Color>
    <Color x:Key="TextPrimaryColor">#F7F2FF</Color>
    <Color x:Key="TextSecondaryColor">#B9CAE0</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="BorderFocusColor">#5DD7FF</Color>
    <Color x:Key="BorderDividerColor">#31506E</Color>
    <Color x:Key="BorderPanelColor">#6488C4</Color>
    <Color x:Key="ControlHoverColor">#245575</Color>
    <Color x:Key="ControlPressedColor">#183D5A</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="PanelBorder" Color="{DynamicResource BorderPanelColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{DynamicResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource BorderDividerColor}"/>
    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="{DynamicResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="TitleBarPressedBrush" Color="{DynamicResource ControlPressedColor}"/>
    <LinearGradientBrush x:Key="TerminalBackground" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource SurfaceAppStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceAppEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NeonAccent" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="{DynamicResource AccentCyanColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource AccentIndigoColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleBarSurfaceBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="{DynamicResource SurfaceTitleStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceTitleEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InputSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource SurfaceInputStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceInputEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <Style x:Key="TerminalButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Background" Value="{DynamicResource InputSurfaceBrush}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.78"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
      <Setter Property="Background" Value="{DynamicResource NeonAccent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="18,9"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="AccentButtonSurface" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="AccentButtonSurface" Property="Opacity" Value="0.84"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="AccentButtonSurface" Property="Opacity" Value="0.68"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="AccentButtonSurface" Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseTitleBarButton" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarHoverBrush}"/></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource TitleBarPressedBrush}"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="WindowShell" Background="{DynamicResource TerminalBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="40"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Border Background="{DynamicResource TitleBarSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
            <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource NeonAccent}">
              <TextBlock Text="!" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource AccentForegroundBrush}"/>
            </Border>
            <TextBlock Text="AMacQ · 启动提示" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"/>
          </StackPanel>
          <Button Name="CloseButton" Content="×" Width="42" Height="40" HorizontalAlignment="Right" FontSize="22" Style="{StaticResource CloseTitleBarButton}"/>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="32,20,32,18">
        <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="程序需要管理员权限，是否以管理员身份启动？" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Name="StatusText" Grid.Row="1" TextWrapping="Wrap" FontSize="11" Foreground="#FB7185" Margin="0,0,0,10" Visibility="Collapsed"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Name="ContinueButton" Content="关闭程序" Style="{StaticResource TerminalButton}" Margin="0,0,10,0" IsCancel="True"/>
          <Button Name="RestartButton" Content="以管理员身份重启" Style="{StaticResource AccentButton}" IsDefault="True"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>