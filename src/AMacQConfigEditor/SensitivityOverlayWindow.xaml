<Window x:Class="AMacQConfigEditor.SensitivityOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMacQ Sensitivity Overlay"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        Focusable="False"
        IsHitTestVisible="False"
        Opacity="0">
  <TextBlock x:Name="DisplayText"
             Margin="12"
             FontFamily="Segoe UI"
             FontSize="17"
             FontWeight="SemiBold"
             Foreground="#FF39FF88"
             TextOptions.TextFormattingMode="Display">
    <TextBlock.Effect>
      <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.9" Color="#FF000000"/>
    </TextBlock.Effect>
  </TextBlock>
</Window>
