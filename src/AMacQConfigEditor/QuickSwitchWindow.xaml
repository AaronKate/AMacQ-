<Window x:Class="AMacQConfigEditor.QuickSwitchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AMacQ 快速切换" Width="340" Height="330"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="CenterScreen"
        Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI">
  <Window.Resources>
    <Color x:Key="SurfaceAppStartColor">#172D4A</Color>
    <Color x:Key="SurfaceAppEndColor">#091421</Color>
    <Color x:Key="SurfaceTitleStartColor">#1F4268</Color>
    <Color x:Key="SurfaceTitleEndColor">#10233B</Color>
    <Color x:Key="AccentCyanColor">#22D3EE</Color>
    <Color x:Key="AccentIndigoColor">#6366F1</Color>
    <Color x:Key="SurfacePanelStartColor">#1A3556</Color>
    <Color x:Key="SurfacePanelEndColor">#0F2038</Color>
    <Color x:Key="SurfaceInputStartColor">#132440</Color>
    <Color x:Key="SurfaceInputEndColor">#0D1B32</Color>
    <Color x:Key="TextPrimaryColor">#F7F2FF</Color>
    <Color x:Key="TextBodyColor">#EDE7FF</Color>
    <Color x:Key="TextSecondaryColor">#B9CAE0</Color>
    <Color x:Key="TextListColor">#DCEBFA</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="BorderControlColor">#4E8FAE</Color>
    <Color x:Key="BorderFocusColor">#5DD7FF</Color>
    <Color x:Key="BorderDividerColor">#31506E</Color>
    <Color x:Key="BorderPanelColor">#6488C4</Color>
    <Color x:Key="ControlHoverColor">#1E5274</Color>
    <Color x:Key="ControlPressedColor">#17415F</Color>
    <Color x:Key="ScrollTrackColor">#10243A</Color>
    <Color x:Key="ScrollThumbColor">#5577C8</Color>
    <Color x:Key="ScrollThumbHoverColor">#71E1FF</Color>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ListItemTextBrush" Color="{DynamicResource TextListColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource BorderControlColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{DynamicResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource BorderDividerColor}"/>
    <SolidColorBrush x:Key="PanelOutlineBrush" Color="{DynamicResource BorderPanelColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverColor}"/>
    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource SurfaceAppStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceAppEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InputSurfaceBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource SurfaceInputStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceInputEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="{DynamicResource AccentCyanColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource AccentIndigoColor}" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="SearchBox" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="CaretBrush" Value="{DynamicResource FocusBorderBrush}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Template">
        <Setter.Value>
          <!-- 这里不要再写 Margin="{TemplateBinding Padding}"：TextBox 自身已按 Padding 内缩内容，
               再叠加一次会让文字与光标偏右（占位文字与光标对不齐），垂直方向过窄时还会把字形裁成一条细缝。 -->
          <ControlTemplate TargetType="TextBox">
            <ScrollViewer x:Name="PART_ContentHost" VerticalContentAlignment="Center"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="WeaponRow" TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource ListItemTextBrush}"/>
      <Setter Property="Padding" Value="10,5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="RowBorder" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 显示中文名：主窗口列表也是这个口径，输入"野牛"时列表里就该看到"野牛"。 -->
                <TextBlock x:Name="RowName" Text="{Binding DisplayName}" Foreground="{TemplateBinding Foreground}"
                           FontSize="13" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="RowSummary" Grid.Row="1" Text="{Binding Summary}" Margin="0,1,0,0"
                           Foreground="{DynamicResource FocusBorderBrush}" FontSize="10"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <DataTrigger Binding="{Binding HasSummary}" Value="False">
                <Setter TargetName="RowSummary" Property="Visibility" Value="Collapsed"/>
              </DataTrigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                <Setter TargetName="RowSummary" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border Background="{DynamicResource AppBackgroundBrush}"
          BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="12">
    <Grid Margin="12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="快速切换枪械" FontSize="11" FontWeight="SemiBold"
                 Foreground="{DynamicResource SecondaryTextBrush}" Margin="2,0,0,6"/>

      <Border Grid.Row="1" Background="{DynamicResource InputSurfaceBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
        <Grid>
          <TextBox Name="SearchBox" Style="{StaticResource SearchBox}" Padding="9,0" Height="30"
                   VerticalContentAlignment="Center"/>
          <TextBlock Name="SearchPlaceholder" Text="搜索枪械，如 mk4 / 野牛"
                     FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
          <TextBlock Name="SearchCount" FontSize="10" Foreground="{DynamicResource SecondaryTextBrush}"
                     Margin="0,0,10,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
      </Border>

      <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8">
        <ListBox Name="WeaponList" Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource WeaponRow}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      </Border>

      <TextBlock Name="EmptyHint" Grid.Row="2" Text="没有匹配的枪械" FontSize="11"
                 Foreground="{DynamicResource SecondaryTextBrush}" HorizontalAlignment="Center"
                 VerticalAlignment="Center" Visibility="Collapsed"/>

      <Grid Grid.Row="3" Margin="2,8,2,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Name="CurrentWeaponText" FontSize="11"
                   Foreground="{DynamicResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis"/>
        <TextBlock Name="PendingWeaponText" Grid.Column="1" FontSize="11" Margin="8,0,0,0"
                   Foreground="{DynamicResource FocusBorderBrush}" TextTrimming="CharacterEllipsis"/>
      </Grid>

      <TextBlock Grid.Row="4" FontSize="10" Margin="2,5,2,0" TextWrapping="Wrap"
                 Foreground="{DynamicResource SecondaryTextBrush}"
                 Text="↑/↓ 选择 · Enter 切换并等待按侧键绑定 · Alt/Ctrl + Enter 绑对应槽位 · Esc 取消"/>
    </Grid>
  </Border>
</Window>
