<Window x:Class="AMacQConfigEditor.HelpWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="使用说明" Width="900" Height="760" MinWidth="760" MinHeight="600"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}" FontFamily="Segoe UI">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="12" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <!-- Theme palette: default colors are overridden at runtime from the main window's active theme. -->
    <Color x:Key="SurfaceAppStartColor">#172D4A</Color>
    <Color x:Key="SurfaceAppEndColor">#091421</Color>
    <Color x:Key="SurfaceTitleStartColor">#1F4268</Color>
    <Color x:Key="SurfaceTitleEndColor">#10233B</Color>
    <Color x:Key="AccentCyanColor">#22D3EE</Color>
    <Color x:Key="AccentIndigoColor">#6366F1</Color>
    <Color x:Key="SurfaceSidebarStartColor">#1A243F</Color>
    <Color x:Key="SurfaceSidebarEndColor">#10192D</Color>
    <Color x:Key="SurfaceContentStartColor">#1B3F62</Color>
    <Color x:Key="SurfaceContentEndColor">#0B1428</Color>
    <Color x:Key="SurfacePanelStartColor">#1A3556</Color>
    <Color x:Key="SurfacePanelEndColor">#0F2038</Color>
    <Color x:Key="SurfaceInputStartColor">#132440</Color>
    <Color x:Key="SurfaceInputEndColor">#0D1B32</Color>
    <Color x:Key="SurfacePopupStartColor">#142942</Color>
    <Color x:Key="SurfacePopupEndColor">#091526</Color>
    <Color x:Key="TextPrimaryColor">#F7F2FF</Color>
    <Color x:Key="TextBodyColor">#EDE7FF</Color>
    <Color x:Key="TextSecondaryColor">#B9CAE0</Color>
    <Color x:Key="TextListColor">#DCEBFA</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="BorderControlColor">#4E8FAE</Color>
    <Color x:Key="BorderFocusColor">#5DD7FF</Color>
    <Color x:Key="BorderDividerColor">#31506E</Color>
    <Color x:Key="BorderPanelColor">#6488C4</Color>
    <Color x:Key="ControlHoverColor">#1E5274</Color>
    <Color x:Key="ControlPressedColor">#17415F</Color>
    <Color x:Key="ScrollTrackColor">#10243A</Color>
    <Color x:Key="ScrollThumbColor">#5577C8</Color>
    <Color x:Key="ScrollThumbHoverColor">#71E1FF</Color>
    <Color x:Key="DangerCloseHoverColor">#C42B4B</Color>
    <Color x:Key="TitleBarDividerColor">#30FFFFFF</Color>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{DynamicResource TextPrimaryColor}"/>
    <SolidColorBrush x:Key="BodyTextBrush" Color="{DynamicResource TextBodyColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{DynamicResource TextSecondaryColor}"/>
    <SolidColorBrush x:Key="ListItemTextBrush" Color="{DynamicResource TextListColor}"/>
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{DynamicResource AccentForegroundColor}"/>
    <SolidColorBrush x:Key="ControlBorderBrush" Color="{DynamicResource BorderControlColor}"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="{DynamicResource BorderFocusColor}"/>
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource BorderDividerColor}"/>
    <SolidColorBrush x:Key="PanelOutlineBrush" Color="{DynamicResource BorderPanelColor}"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="{DynamicResource ControlHoverColor}"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="{DynamicResource ControlPressedColor}"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="{DynamicResource ScrollTrackColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="{DynamicResource ScrollThumbColor}"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{DynamicResource ScrollThumbHoverColor}"/>
    <SolidColorBrush x:Key="WindowCloseHoverBrush" Color="{DynamicResource DangerCloseHoverColor}"/>
    <SolidColorBrush x:Key="TitleBarDividerBrush" Color="{DynamicResource TitleBarDividerColor}"/>

    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="{DynamicResource SurfaceAppStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceAppEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TitleBarSurfaceBrush" StartPoint="0,0" EndPoint="1,0" Opacity="0.88">
      <GradientStop Color="{DynamicResource SurfaceTitleStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceTitleEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="{DynamicResource AccentCyanColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource AccentIndigoColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="InputSurfaceBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.88">
      <GradientStop Color="{DynamicResource SurfaceInputStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfaceInputEndColor}" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PopupSurfaceBrush" StartPoint="0,0" EndPoint="1,1" Opacity="0.99">
      <GradientStop Color="{DynamicResource SurfacePopupStartColor}" Offset="0"/>
      <GradientStop Color="{DynamicResource SurfacePopupEndColor}" Offset="1"/>
    </LinearGradientBrush>

    <Style x:Key="DarkScrollThumb" TargetType="Thumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="ScrollThumb" Background="{DynamicResource ScrollThumbBrush}" CornerRadius="5" Margin="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource FocusBorderBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkScrollTrackButton" TargetType="RepeatButton">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border x:Name="TrackSurface" Background="Transparent" CornerRadius="4"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="11"/>
      <Setter Property="Background" Value="{DynamicResource ScrollTrackBrush}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}" CornerRadius="5" Margin="1">
              <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton x:Name="DecreaseTrackButton" Command="ScrollBar.PageUpCommand" Style="{StaticResource DarkScrollTrackButton}"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource DarkScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton x:Name="IncreaseTrackButton" Command="ScrollBar.PageDownCommand" Style="{StaticResource DarkScrollTrackButton}"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Orientation" Value="Horizontal">
                <Setter TargetName="DecreaseTrackButton" Property="Command" Value="{x:Static ScrollBar.PageLeftCommand}"/>
                <Setter TargetName="IncreaseTrackButton" Property="Command" Value="{x:Static ScrollBar.PageRightCommand}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkTabControl" TargetType="TabControl">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabControl">
            <DockPanel LastChildFill="True">
              <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Top" IsItemsHost="True"
                        Background="Transparent" Margin="0,0,0,14"/>
              <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
            </DockPanel>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="DarkTabItem" TargetType="TabItem">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TabItem">
            <Border x:Name="TabHeaderBorder" Background="Transparent" CornerRadius="7" Padding="16,8" Margin="0,0,8,0">
              <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="TabHeaderBorder" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="TabHeaderBorder" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TitleBarButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="38"/>
      <Setter Property="Foreground" Value="{DynamicResource BodyTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CloseTitleBarButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="{DynamicResource WindowCloseHoverBrush}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="7"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.88"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="0.88" Duration="0:0:0.14"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="bd" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Opacity" Value="0.72"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="12" ClipToBounds="True">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="38"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      <Grid Name="TitleBar" Grid.Row="0" Background="{DynamicResource TitleBarSurfaceBrush}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Text="使用说明" VerticalAlignment="Center" Margin="16,0,0,0"
                   FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
        <Border Grid.Column="1" shell:WindowChrome.IsHitTestVisibleInChrome="True">
          <Button Name="HelpWindowCloseButton" Content="&#xE8BB;" ToolTip="关闭" Style="{StaticResource CloseTitleBarButton}"/>
        </Border>
        <Border Grid.ColumnSpan="2" BorderBrush="{DynamicResource TitleBarDividerBrush}" BorderThickness="0,0,0,1" IsHitTestVisible="False"/>
      </Grid>

      <Grid Grid.Row="1">
        <TabControl Style="{StaticResource DarkTabControl}" Margin="20,18,8,20">
          <TabItem Header="导入步骤" Style="{StaticResource DarkTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,12,0">
                <TextBlock Text="准备工作：安装罗技驱动" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="本脚本基于罗技鼠标的官方软件（罗技 G HUB）运行，使用前请先下载并安装驱动：" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,8"/>
                <TextBlock Margin="0,0,0,18">
                  <Hyperlink NavigateUri="https://download01.logi.com/web/ftp/pub/techsupport/gaming/lghub_installer.exe"
                             RequestNavigate="OpenExternalLink"
                             Foreground="#22D3EE" TextDecorations="Underline">
                    <Run Text="https://download01.logi.com/web/ftp/pub/techsupport/gaming/lghub_installer.exe"/>
                  </Hyperlink>
                </TextBlock>

                <TextBlock Text="验证宏是否生效" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="按住鼠标左键，或按住右键再按左键，如果看到鼠标自动往下滑，说明宏已生效。" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,18"/>

                <TextBlock Text="1. 打开配置文件管理" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                <TextBlock Text="在右上角打开当前配置文件的下拉菜单，然后点击“管理配置文件”。" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                <Image Source="Resources/Guide/01-open-profile-menu.png" MaxWidth="640" MaxHeight="340" Stretch="Uniform" HorizontalAlignment="Left"
                       Cursor="Hand" ToolTip="点击放大查看" MouseLeftButtonUp="OpenGuideImage"/>

                <TextBlock Text="2. 选择桌面配置文件" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,22,0,0"/>
                <TextBlock Text="在配置文件列表中选择“桌面”，进入该配置文件。" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                <Image Source="Resources/Guide/02-select-desktop-profile.png" MaxWidth="640" MaxHeight="440" Stretch="Uniform" HorizontalAlignment="Left"
                       Cursor="Hand" ToolTip="点击放大查看" MouseLeftButtonUp="OpenGuideImage"/>

                <TextBlock Text="3. 创建 LUA 脚本" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,22,0,0"/>
                <TextBlock Text="点击配置文件卡片右侧的三点菜单，选择“创建 LUA 脚本”。" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                <Image Source="Resources/Guide/03-create-lua-script.png" MaxWidth="640" MaxHeight="440" Stretch="Uniform" HorizontalAlignment="Left"
                       Cursor="Hand" ToolTip="点击放大查看" MouseLeftButtonUp="OpenGuideImage"/>

                <TextBlock Text="4. 导入脚本文件" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,22,0,0"/>
                <TextBlock Text="在脚本编辑器左上角打开菜单，点击“导入”，并选择部署后生成的 LUA 启动脚本。" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                <Image Source="Resources/Guide/04-import-lua-file.png" MaxWidth="640" MaxHeight="340" Stretch="Uniform" HorizontalAlignment="Left"
                       Cursor="Hand" ToolTip="点击放大查看" MouseLeftButtonUp="OpenGuideImage"/>

                <TextBlock Text="5. 保存并运行" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,22,0,0"/>
                <TextBlock Text="导入完成后，在同一菜单中点击“保存并运行”，使脚本立即生效。" TextWrapping="Wrap"
                           FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,8"/>
                <Image Source="Resources/Guide/05-save-and-run.png" MaxWidth="640" MaxHeight="340" Stretch="Uniform" HorizontalAlignment="Left"
                       Cursor="Hand" ToolTip="点击放大查看" MouseLeftButtonUp="OpenGuideImage"/>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="按键说明" Style="{StaticResource DarkTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,12,0">
                <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                  <StackPanel>
                    <TextBlock Text="按键说明" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="按键 0：不绑定。&#x0a;按键 4：左侧后退键。&#x0a;按键 5：左侧前进键。&#x0a;按键 7、8：带右侧按键的鼠标可用的右侧后退键、前进键。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                    <TextBlock Text="无修饰键为直接按侧键；Alt 和 Ctrl 分别表示按住对应键后再按侧键。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="触发方式可选鼠标左键，或按住右键再按左键。灵敏度切换键可选择 Scroll Lock、Caps Lock 或 Num Lock。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="关闭宏：按下鼠标中键（按下滚轮）即可关闭宏。" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,0"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="调整压枪" Style="{StaticResource DarkTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,12,0">
                <Border Background="#33FFB45B" BorderBrush="#FFB45B" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,0,0,16">
                  <StackPanel>
                    <TextBlock Text="重要提醒" FontSize="15" FontWeight="SemiBold" Foreground="#FFD08A"/>
                    <TextBlock Text="请在大战场模式下现场调整，不要在靶场中测试，防止被官方标记进小黑屋。" TextWrapping="Wrap"
                               FontSize="13" Foreground="#FFE8C9" Margin="0,8,0,0" LineHeight="22"/>
                    <TextBlock Text="压枪幅度别调太狠，系统会检测历史枪法和 KD，幅度过大会引起注意。" TextWrapping="Wrap"
                               FontSize="13" Foreground="#FFE8C9" Margin="0,8,0,0" LineHeight="22"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                  <StackPanel>
                    <TextBlock Text="压枪幅度由“灵敏度 Y”控制" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="在左侧列表选中枪械后，在“配置详情”中调整数值，修改后点击“应用”生效。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" LineHeight="22"/>
                    <TextBlock Text="灵敏度 Y：垂直方向的压枪幅度。数值越大，鼠标自动下拉越快，压枪越狠；数值越小越轻。一般从 0 附近的小数值开始试，根据弹道逐步加大。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                    <TextBlock Text="灵敏度 X：水平方向的补偿。枪口左右偏移明显时才需要调整，一般保持 0 即可。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                    <TextBlock Text="灵敏度增幅 X / Y：按住增幅激活键时在基础值上额外叠加的幅度。适用于弹匣后半段后坐力明显变大的情况。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                    <TextBlock Text="增幅激活键在“全局设置”中选择（Scroll Lock / Caps Lock / Num Lock），按住该键射击即启用增幅。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                  </StackPanel>
                </Border>
                <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="16" Margin="0,16,0,0">
                  <StackPanel>
                    <TextBlock Text="调整步骤" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="1. 在左侧列表选中目标枪械。&#x0a;2. 将“灵敏度 Y”设为较小值（如 0.5），点击“应用”后进游戏试射。&#x0a;3. 观察弹道：准星上飘则加大数值，压过头（准星向下偏移）则减小数值，直到弹道基本稳定。&#x0a;4. 若弹匣后半段仍上飘，设置“灵敏度增幅 Y”并按同样方法微调。&#x0a;5. 每把枪械的幅度相互独立，需要逐枪分别调整。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" LineHeight="24"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="使用须知" Style="{StaticResource DarkTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,12,0">
                <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                  <StackPanel>
                    <TextBlock Text="使用须知" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="1. 自动屏息按键请调整为默认的 Shift 键，并且这个键不要在其他操作中使用。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                    <TextBlock Text="2. 游戏中鼠标中键默认为标记功能，而鼠标中键也是关闭宏的按键。请将游戏内的标记按键改为其它顺手的按键，防止标记时误把宏关闭。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                    <TextBlock Text="3. 游戏中需要全程开启本程序，宏才能正常使用。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,10,0,0" LineHeight="22"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="常见问题" Style="{StaticResource DarkTabItem}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="0,0,12,0">
                <Border Background="{DynamicResource InputSurfaceBrush}" BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="7" Padding="16">
                  <StackPanel>
                    <TextBlock Text="常见问题" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <TextBlock Text="桌面能用左键或右键+左键触发宏，但进入游戏后无法触发。" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="大多数游戏需要管理员权限，而罗技驱动未以管理员身份运行，导致游戏无法读取宏指令。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0"/>
                    <TextBlock Text="解决方法：" TextWrapping="Wrap"
                               FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,12,0,0"/>
                    <TextBlock Text="1. 先退出罗技 G HUB 启动程序。&#x0a;2. 通过桌面快捷方式找到罗技驱动的 exe 程序。&#x0a;3. 鼠标右键该 exe，选择“属性”。&#x0a;4. 在“兼容性”选项卡中，勾选“以管理员身份运行此程序”。&#x0a;5. 点击确定后重新启动罗技驱动，再进入游戏即可正常触发宏。" TextWrapping="Wrap"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,8,0,0" LineHeight="22"/>
                  </StackPanel>
                </Border>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Grid>

      <Grid Name="GuideImageOverlay" Grid.RowSpan="2" Background="#D906101D" Visibility="Collapsed" Panel.ZIndex="12"
            MouseLeftButtonUp="CloseGuideImageWhenBackgroundClicked">
        <Border Width="860" Height="600" Padding="16" Background="{DynamicResource PopupSurfaceBrush}"
                BorderBrush="{DynamicResource PanelOutlineBrush}" BorderThickness="1" CornerRadius="12"
                HorizontalAlignment="Center" VerticalAlignment="Center">
          <DockPanel LastChildFill="True">
            <Button Name="GuideImageCloseButton" Content="关闭" Style="{StaticResource PrimaryButton}"
                    Background="{StaticResource AccentGradientBrush}" Foreground="{DynamicResource AccentForegroundBrush}"
                    Padding="24,8" Margin="0,12,0,0" HorizontalAlignment="Right" DockPanel.Dock="Bottom"/>
            <ScrollViewer Name="GuideImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          PreviewMouseWheel="ZoomGuideImage">
              <Image Name="GuideImagePreview" Stretch="Uniform" Cursor="Hand"
                     MouseLeftButtonDown="BeginGuideImageDrag" MouseMove="DragGuideImage" MouseLeftButtonUp="EndGuideImageDrag"/>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
